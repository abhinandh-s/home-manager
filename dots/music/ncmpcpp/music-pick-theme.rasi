/**
 * music-pick-theme.rasi — Catppuccin Mocha, zero frills
 */

* {
    bg:      #1e1e2e;
    surface: #313244;
    overlay: #45475a;
    text:    #cdd6f4;
    subtle:  #6c7086;
    accent:  #cba6f7;
    green:   #a6e3a1;

    background-color: transparent;
    text-color:       @text;
    border-color:     transparent;
    font:             "Iosevka 11";
}

window {
    background-color: @bg;
    border:           1px;
    border-color:     @overlay;
    border-radius:    8px;
    width:            600px;
    padding:          0px;
}

mainbox {
    background-color: @bg;
    children:         [ inputbar, listview ];
    spacing:          0px;
    padding:          0px;
}

inputbar {
    background-color: @surface;
    border:           0px 0px 1px 0px;
    border-color:     @overlay;
    border-radius:    8px 8px 0px 0px;
    padding:          10px 14px;
    spacing:          8px;
    children:         [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color:       @accent;
}

entry {
    background-color: transparent;
    text-color:       @text;
    placeholder:      "search…";
    placeholder-color: @subtle;
    cursor:           text;
}

listview {
    background-color: @bg;
    padding:          4px 0px;
    spacing:          0px;
    lines:            12;
    columns:          1;
    scrollbar:        false;
    fixed-height:     true;
}

element {
    background-color: transparent;
    padding:          8px 14px;
    spacing:          0px;
    border-radius:    0px;
    children:         [ element-text ];
}

element-text {
    background-color: transparent;
    text-color:       @subtle;
    vertical-align:   0.5;
    highlight:        bold;
}

element normal.normal {
    background-color: transparent;
}

element selected.normal {
    background-color: @surface;
    text-color:       @text;
}

element alternate.normal {
    background-color: transparent;
}
